[Unit]
Description=Manage Framework cooling and power profile for GPU inference workloads
Wants=tuned.service
After=multi-user.target tuned.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/sbin/gpu-workload-watch
Restart=always
RestartSec=1
WatchdogSec=30s
WatchdogSignal=TERM
LimitCORE=0

[Install]
WantedBy=multi-user.target
